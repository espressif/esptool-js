{
  "name": "esptool-js",
  "version": "0.6.1",
  "module": "lib/index.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "bundle.js",
    "wasm"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:wasm && npm run build:js",
    "build:js": "rimraf lib bundle.js && tsc && rollup --config",
    "build:wasm": "bash scripts/build-wasm.sh",
    "clean": "rimraf lib bundle.js .parcel-cache esptool-js-*.tgz",
    "clean:wasm": "bash scripts/clean-wasm.sh",
    "format": "prettier --write \"src/**/*.ts\"",
    "genDocs": "rimraf docs && typedoc",
    "lint": "eslint .",
    "lintAndFix": "eslint . --fix",
    "prepare": "npm run build:js",
    "test": "echo \"Error: no test specified\"",
    "prepublishOnly": "npm run test && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espressif/esptool-js.git"
  },
  "bugs": {
    "url": "https://github.com/espressif/esptool-js/issues"
  },
  "dependencies": {
    "pako": "^3.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
