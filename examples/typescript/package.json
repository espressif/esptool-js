{
  "name": "typescript",
  "version": "1.0.0",
  "description": "This an example of using esptool-js with parcel and typescript",
  "source": "src/index.html",
  "scripts": {
    "build": "npm-run-all clean genDocs parcel:build",
    "clean": "shx rm -rf dist .parcel-cache",
    "dev": "npm-run-all clean genDocs parcel:dev",
    "genDocs": "npm run genDocs:root && shx mkdir -p dist && shx cp -r ../../docs dist",
    "genDocs:root": "cd ../.. && npm run genDocs",
    "parcel:dev": "cross-env PARCEL_WORKERS=0 parcel src/index.html",
    "parcel:build": "cross-env PARCEL_WORKERS=0 parcel build src/index.html --no-optimize --public-url ./",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "parcelIgnore": [
    "./docs/.+"
  ],
  "alias": {
    "esp-flasher-stub/esp32.json": "../../node_modules/esp-flasher-stub/stubs/esp32.json",
    "esp-flasher-stub/esp32c2.json": "../../node_modules/esp-flasher-stub/stubs/esp32c2.json",
    "esp-flasher-stub/esp32c3.json": "../../node_modules/esp-flasher-stub/stubs/esp32c3.json",
    "esp-flasher-stub/esp32c5.json": "../../node_modules/esp-flasher-stub/stubs/esp32c5.json",
    "esp-flasher-stub/esp32c6.json": "../../node_modules/esp-flasher-stub/stubs/esp32c6.json",
    "esp-flasher-stub/esp32c61.json": "../../node_modules/esp-flasher-stub/stubs/esp32c61.json",
    "esp-flasher-stub/esp32h2.json": "../../node_modules/esp-flasher-stub/stubs/esp32h2.json",
    "esp-flasher-stub/esp32h4.json": "../../node_modules/esp-flasher-stub/stubs/esp32h4.json",
    "esp-flasher-stub/esp32h21.json": "../../node_modules/esp-flasher-stub/stubs/esp32h21.json",
    "esp-flasher-stub/esp32p4.json": "../../node_modules/esp-flasher-stub/stubs/esp32p4.json",
    "esp-flasher-stub/esp32p4-rev1.json": "../../node_modules/esp-flasher-stub/stubs/esp32p4-rev1.json",
    "esp-flasher-stub/esp32s2.json": "../../node_modules/esp-flasher-stub/stubs/esp32s2.json",
    "esp-flasher-stub/esp32s3.json": "../../node_modules/esp-flasher-stub/stubs/esp32s3.json",
    "esp-flasher-stub/esp32s31.json": "../../node_modules/esp-flasher-stub/stubs/esp32s31.json",
    "esp-flasher-stub/esp8266.json": "../../node_modules/esp-flasher-stub/stubs/esp8266.json"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.10",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.8.3",
    "parcel-resolver-ignore": "^2.1.5",
    "shx": "^0.3.4",
    "typescript": "^4.9.4",
    "web-serial-polyfill": "^1.0.15"
  }
}
